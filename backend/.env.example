# FieldProof backend - copy to .env and edit. NEVER commit .env.
FIELDPROOF_ENVIRONMENT=development
FIELDPROOF_DATABASE_URL=sqlite:///./data/fieldproof.db
# Use a long random value in production (>= 32 chars).
FIELDPROOF_JWT_SECRET=change-me-to-a-long-random-string
FIELDPROOF_ACCESS_TOKEN_EXPIRE_MINUTES=720
FIELDPROOF_LOGIN_MAX_ATTEMPTS=5
FIELDPROOF_LOGIN_WINDOW_SECONDS=300
FIELDPROOF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIELDPROOF_ENGINE_VERSION=fp-engine-1.0.0
FIELDPROOF_SEED_DEMO=true
# ECDSA P-256 signing key for records (step 3): env var NAME that holds the PEM,
# or a file path. The private key NEVER leaves the server.
FIELDPROOF_SIGNING_KEY_ENV=FIELDPROOF_SIGNING_PRIVATE_KEY
FIELDPROOF_SIGNING_KEY_FILE=
